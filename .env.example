# ──────────────────────────────────────────────
# Lapidary — environment variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# Storage: sqlite (default, one file under data/) or supabase. Supabase only needs the two lines below.
# GEMS_STORAGE=sqlite
# GEMS_SQLITE_PATH=./data/lapidary.db

# Supabase (hosted mode)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only; the one key the database trusts (ADR-006)

# LLM providers (add the ones you plan to use)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# API Key — protects all /gems and /chat endpoints
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required — the server will refuse to start if this is not set.
GEMS_API_KEY=your-secret-api-key-here

# Which AI should we use? local | online | mix | auto (default) | manual. See README.
# GEMS_MODEL_POLICY=auto
# Local model server, any OpenAI-compatible one (Ollama by default; LM Studio uses 1234).
# LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# GEMS_LOCAL_DEFAULT_MODEL=

# Models (optional). New gems default to GEMS_DEFAULT_PROVIDER / GEMS_DEFAULT_MODEL (auto: the policy decides).
# The UI's model dropdown comes from each provider's live model list, cached for
# GEMS_MODEL_LIST_TTL_SECONDS; set GEMS_MODELS_ANTHROPIC / GEMS_MODELS_OPENAI
# (comma separated) to pin a list instead.
# GEMS_DEFAULT_PROVIDER=anthropic
# GEMS_DEFAULT_MODEL=claude-opus-5-5
# GEMS_MODELS_ANTHROPIC=claude-opus-5-5,claude-sonnet-5-5
# GEMS_MODELS_OPENAI=
# GEMS_MODEL_LIST_TTL_SECONDS=600

# Provider calls (optional): per-attempt timeout, SDK retries, completion cap.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=4096

# Agent runs (optional): model turns per run, and the longest tool result sent back to the model.
# AGENT_MAX_STEPS=8
# AGENT_TOOL_RESULT_MAX_CHARS=8000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Frontend -> Backend proxy (used by next.config.ts)
BACKEND_URL=http://localhost:8000
