# Copy this to .env.local in the frontend/ directory

# Backend URL — used by next.config.ts to proxy /api/* requests to FastAPI
BACKEND_URL=http://localhost:8000

# API key — must match GEMS_API_KEY in your backend .env
# No NEXT_PUBLIC_ prefix: this stays server-side only (never sent to the browser)
GEMS_API_KEY=your-secret-api-key-here
